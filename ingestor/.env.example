# Postie ingestor — Supabase credentials
# Supabase dashboard → Project Settings
#   • SUPABASE_URL            → Data API → Project URL  (https://<ref>.supabase.co)
#   • SUPABASE_SERVICE_ROLE_KEY → API Keys → Secret key (sb_secret_...)
#     (replaces the legacy "service_role" JWT; server-side, bypasses RLS)

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
